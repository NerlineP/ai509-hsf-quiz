# Upstash Redis / Vercel KV credentials for the shared results store.
# Add these in Vercel → Project → Settings → Environment Variables.
# Without them the app still runs, falling back to per-device localStorage.
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=your-rest-token

# Secret required to delete results ("Efase tout rezilta" in the admin dashboard).
# The admin types this value into the confirm dialog; it is sent as the
# x-admin-token header and compared server-side. It is NOT bundled in the client.
# If unset, the delete endpoint is disabled (fail-closed). Use a long random string.
ADMIN_TOKEN=set-a-long-random-secret
